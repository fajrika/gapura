# Lokal (non-Docker): DB jalan sendiri (misal: docker run -d --name gapura-db \
#   -e POSTGRES_USER=gapura -e POSTGRES_PASSWORD=gapura_secret -e POSTGRES_DB=gapura \
#   -p 5433:5432 -v gapura-pgdata:/var/lib/postgresql postgres:18-alpine)
DATABASE_URL="postgres://gapura:gapura_secret@localhost:5433/gapura"

# Secret untuk JWT session (wajib diganti dengan string acak saat produksi)
JWT_SECRET="ganti-dengan-secret-acak"

# Kunci VAPID untuk push notification (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_KEY=""

# URL publik aplikasi (dipakai notifikasi push & tautan)
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# --- Variabel untuk docker-compose (dapat disalin ke .env di root repo) ---
# POSTGRES_USER=gapura
# POSTGRES_PASSWORD=gapura_secret
# POSTGRES_DB=gapura
# Port app di host untuk compose: 3003 (bisa diubah)

# --- Pembayaran online (opsional). Kosongkan untuk mode simulasi. ---
# XENDIT_SECRET_KEY=""
# XENDIT_WEBHOOK_TOKEN=""
# XENDIT_VA_BANK="MANDIRI"

# --- CCTV / go2rtc (opsional). Default: http://<host>:1984 ---
# GO2RTC_URL=""
# GO2RTC_USER=""
# GO2RTC_PASSWORD=""
